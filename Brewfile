brew "zoxide"                   # smarter cd
brew "fzf"                      # fuzzy finder
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Core CLI
brew "git"
brew "gh"
brew "coreutils"
brew "ripgrep"
brew "jq"

# Languages installed via brew (the rest use their own version managers)
brew "go"

cask "ghostty"
